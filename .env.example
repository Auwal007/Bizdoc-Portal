# ---- Required in production (set these in Railway -> Variables) ----

# Password your team types to open the dashboard.
DASHBOARD_PASSWORD=choose-a-strong-password

# Secret used to sign login cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=paste-a-long-random-string-here

# Tells the app it's in production (enables secure cookies). Railway can set this for you.
NODE_ENV=production

# ---- Provided automatically when you add a Postgres database on Railway ----
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ---- Optional ----
# PORT is provided by Railway automatically. Default 3000 locally.
# PGSSL=false   # only if your Postgres does NOT use SSL
